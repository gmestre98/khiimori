<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{{ .Title }} — Khiimori travelogues</title>
    <style>
{{ template "docStyles" . }}
    </style>
  </head>
  <body>
    <div class="meta">Khiimori travelogues</div>
    <div class="doc-title">{{ .Title }}</div>
    <div class="subtitle">{{ len .Trips }} trips · Exported {{ weekdayDate .GeneratedAt }}</div>

    {{ if .Trips }}
      <div class="toc-h">Contents</div>
      <ol class="toc">
        {{ range .Trips }}
          <li>{{ .TripName }}{{ with dateRange .StartDate .EndDate }} — {{ . }}{{ end }}</li>
        {{ end }}
      </ol>
      <p class="meta">Tip: open the document outline (View → Show outline) to jump between trips.</p>

      {{ $total := len .Trips }}
      {{ range $i, $t := .Trips }}
        <div class="trip">
          <hr class="trip-sep" />
          <div class="trip-sep-label">Trip {{ add $i 1 }} of {{ $total }}</div>
{{ template "tripSection" $t }}
        </div>
      {{ end }}
    {{ else }}
      <p class="muted">You don’t have any trips to export yet.</p>
    {{ end }}
  </body>
</html>
