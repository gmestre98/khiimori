<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>{{ .TripName }} — Khiimori travelogue</title>
    <style>
      body { font-family: Arial, sans-serif; color: #1a1a1a; line-height: 1.5; }
      h1 { font-size: 26pt; margin: 0 0 2pt; }
      h2 { font-size: 16pt; border-bottom: 1px solid #888; padding-bottom: 3pt; margin: 24pt 0 8pt; }
      h3 { font-size: 12pt; margin: 12pt 0 4pt; }
      .subtitle { color: #555; font-size: 12pt; }
      .meta { color: #777; font-size: 10pt; }
      .day { page-break-before: always; }
      .stay { background: #eef3fb; padding: 6pt 10pt; margin: 8pt 0; }
      .item { margin: 3pt 0; }
      .time { color: #777; }
      .muted { color: #777; }
      .diary { background: #f6f6f4; padding: 8pt 10pt; margin: 8pt 0; font-style: italic; }
      table { border-collapse: collapse; width: 100%; margin: 8pt 0; }
      th, td { border: 1px solid #ccc; padding: 4pt 8pt; text-align: left; font-size: 10pt; }
      th { background: #f0f0ee; }
      td.num, th.num { text-align: right; }
      .photos img { max-width: 260pt; margin: 4pt 8pt 4pt 0; }
      .caption { color: #777; font-size: 9pt; }
    </style>
  </head>
  <body>
    <div class="meta">Khiimori travelogue</div>
    <h1>{{ .TripName }}</h1>
    {{ if .Destinations }}<div class="subtitle">{{ join " · " .Destinations }}</div>{{ end }}
    <div class="subtitle">{{ dateRange .StartDate .EndDate }} · {{ .DayCount }} days · {{ .Currency }}</div>
    <div class="meta">Exported from Khiimori · {{ weekdayDate .GeneratedAt }}</div>

    {{ if .Budget.Categories }}
      <h2>Budget</h2>
      <table>
        <tr><th>Category</th><th class="num">Planned</th><th class="num">Spent</th><th class="num">Upcoming</th></tr>
        {{ $cur := .Budget.Currency }}
        {{ range .Budget.Categories }}
          <tr>
            <td>{{ .Name }}</td>
            <td class="num">{{ money $cur .Planned }}</td>
            <td class="num">{{ money $cur .Spent }}</td>
            <td class="num">{{ money $cur .Estimated }}</td>
          </tr>
        {{ end }}
        <tr>
          <th>Total</th>
          <th class="num">{{ money $cur .Budget.PlannedTotal }}</th>
          <th class="num">{{ money $cur .Budget.SpentTotal }}</th>
          <th class="num">{{ money $cur .Budget.EstimatedTotal }}</th>
        </tr>
      </table>
    {{ end }}

    {{ $cur := .Currency }}
    {{ range .Days }}
      <div class="day">
        <h2>{{ dayHeading . }}</h2>

        {{ with .Stay }}
          <div class="stay">
            <strong>Stay:</strong> {{ .Name }}{{ if nonEmpty .Location }} · {{ .Location }}{{ end }}
            {{ if .CheckOut }}· check-out {{ weekdayDate .CheckOut }}{{ end }}
            {{ if .Cost }}· {{ money $cur .Cost }}{{ end }}
            {{ if .Paid }}· paid{{ end }}
            {{ if nonEmpty .Link }}· <a href="{{ .Link }}">booking</a>{{ end }}
          </div>
        {{ end }}

        {{ if .Planned }}
          <h3>Plan</h3>
          {{ range .Planned }}
            <div class="item">
              {{ if nonEmpty .StartTime }}<span class="time">{{ .StartTime }}</span> {{ end }}
              <strong>{{ .Title }}</strong>
              {{ if eq .Kind "transport" }}
                <span class="muted">
                  {{- if nonEmpty .Origin }} · {{ .Origin }} → {{ .Destination }}{{ end -}}
                  {{- if nonEmpty .ArriveTime }} · arrives {{ .ArriveTime }}{{ end -}}
                </span>
              {{ else if nonEmpty .Location }}<span class="muted"> · {{ .Location }}</span>{{ end }}
              {{ if nonEmpty .BookingStatus }}<span class="muted"> · {{ .BookingStatus }}</span>{{ end }}
              {{ if .Cost }}<span class="muted"> · {{ money $cur .Cost }}</span>{{ end }}
              {{ if nonEmpty .Note }}<div class="muted">{{ .Note }}</div>{{ end }}
            </div>
          {{ end }}
        {{ end }}

        {{ if .WhatHappened }}
          <h3>What happened</h3>
          {{ range .WhatHappened }}
            <div class="item">
              ✓ <strong>{{ .Title }}</strong>
              {{ if nonEmpty .Location }}<span class="muted"> · {{ .Location }}</span>{{ end }}
              {{ if .Cost }}<span class="muted"> · {{ money $cur .Cost }}</span>{{ end }}
              {{ if nonEmpty .Note }}<div class="muted">{{ .Note }}</div>{{ end }}
            </div>
          {{ end }}
        {{ end }}

        {{ with .Journal }}
          {{ if or (nonEmpty .Text) .Rating (nonEmpty .Weather) (nonEmpty .Mood) }}
            <h3>Diary</h3>
            <div class="diary">
              <div class="caption">
                {{ if .Rating }}{{ stars .Rating }} {{ end }}
                {{ if nonEmpty .Weather }}· {{ .Weather }} {{ end }}
                {{ if nonEmpty .Mood }}· {{ .Mood }}{{ end }}
              </div>
              {{ if nonEmpty .Text }}<div>{{ .Text }}</div>{{ end }}
            </div>
          {{ end }}
        {{ end }}
      </div>
    {{ end }}
  </body>
</html>
